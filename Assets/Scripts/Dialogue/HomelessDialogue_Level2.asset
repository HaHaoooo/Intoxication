  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 05baf6446e8e3440d9ed167e8ec04d30, type: 3}
  m_Name: HomelessDialogue_Level2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: You
    text: Hey. Do you remember me?
  - speaker: Homeless Man
    text: You came back faster this time.
  - speaker: You
    text: "What do you mean \u201Cthis time\u201D?"
  - speaker: Homeless Man
    text: You always ask the same questions.
  - speaker: You
    text: "No, I don\u2019t. I just need to know what\u2019s happening."
  - speaker: Homeless Man
    text: Then stop looking at the street.
  - speaker: You
    text: What?
  - speaker: Homeless Man
    text: Look at yourself.
  - speaker: You
    text: "You\u2019re not making sense."
  - speaker: Homeless Man
    text: "That\u2019s what they all say before everything disappears."
  - speaker: You
    text: Who disappears?
  - speaker: Homeless Man
    text: Everyone you made up.
  - speaker: You
    text: Made up?
  - speaker: Homeless Man
    text: The bartender. The girl. Me.
  - speaker: You
    text: "No. You\u2019re real. I\u2019m talking to you right now."
  - speaker: Homeless Man
    text: Are you?
