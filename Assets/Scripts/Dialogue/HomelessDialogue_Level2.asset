  m_Script: {fileID: 11500000, guid: 05baf6446e8e3440d9ed167e8ec04d30, type: 3}
  m_Name: HomelessDialogue_Level2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: Homeless Man
    text: You again. Did you find what you were looking for?
  - speaker: You
    text: I'm trying to get home.
  - speaker: Homeless Man
    text: Home is gone, kid. You should have stayed in the alley.
  - speaker: You
    text: Who are you?
  - speaker: Homeless Man
    text: Doesn't matter now. Just don't look back.
