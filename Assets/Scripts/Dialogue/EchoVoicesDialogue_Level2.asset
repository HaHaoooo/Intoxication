  m_Script: {fileID: 11500000, guid: 05baf6446e8e3440d9ed167e8ec04d30, type: 3}
  m_Name: EchoVoicesDialogue_Level2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: Bartender Echo
    text: Drink slowly, sir...
  - speaker: Radio Echo
    text: Breaking news...
  - speaker: Homeless Man Echo
    text: You were talking to empty air...
  - speaker: Little Girl Echo
    text: You promised...
  - speaker: You
    text: Stop. Stop talking.
  - speaker: You
    text: I didn't do anything.
  - speaker: Little Girl Voice
    text: Then why are you running?
