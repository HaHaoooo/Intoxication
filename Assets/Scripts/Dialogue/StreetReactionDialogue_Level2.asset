  m_Script: {fileID: 11500000, guid: 05baf6446e8e3440d9ed167e8ec04d30, type: 3}
  m_Name: StreetReactionDialogue_Level2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: You
    text: What the hell...
  - speaker: You
    text: What happened to these buildings?
  - speaker: You
    text: This street was straight before.
  - speaker: You
    text: "No, no\u2026 this is not real. I just need to keep walking."
  - speaker: Little Girl Voice
    text: You said that last time.
  - speaker: You
    text: Who's there?
  - speaker: Little Girl Voice
    text: You always keep walking away.
