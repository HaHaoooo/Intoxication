  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 05baf6446e8e3440d9ed167e8ec04d30, type: 3}
  m_Name: BartenderDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: Bartender
    text: Welcome! What do you want, sir!
  - speaker: You
    text: Have a bottle of the best wine here.
  - speaker: Bartender
    text: Ok. Just wait a moment...
  - speaker: Bartender
    text: Do you know that something happened recently.
  - speaker: Bartender
    text: There is a murderer of a serial murder case.
  - speaker: Bartender
    text: I heard that he has been wandering around our area recently...
  - speaker: You
    text: Hope everything goes well...
  - speaker: Bartender
    text: Here you are. This is our signature.
  - speaker: You
    text: Thanks.
  - speaker: Bartender
    text: And sir... be careful when you leave.
  - speaker: You
    text: Why?
  - speaker: Bartender
    text: People like that murderer do not always plan everything.
  - speaker: Bartender
    text: Sometimes they just pick up whatever is around them.
  - speaker: You
    text: What do you mean?
  - speaker: Bartender
    text: Bottles. Pipes. Broken tools. Even an axe.
  - speaker: Bartender
    text: Anything can become a weapon in the wrong hands.
  - speaker: You
    text: That sounds pretty serious.
  - speaker: Bartender
    text: It is. If you see something strange outside, do not get close.
  - speaker: Bartender
    text: And if someone comes after you...
  - speaker: Bartender
    text: Use whatever you can to survive.
  - speaker: You
    text: I understand.
  - speaker: Bartender
    text: Good. Now drink slowly, sir. It is a dangerous night.
